# =============================================================================
# .gitignore — Samaktha
# Repository policy for generated, machine-local, and security-sensitive state.
# Categories: Python artifacts | Caches | Virtual envs | Config | Databases |
#             Logs | Runtime data | Temp/debug | IDE | OS | Build | Scratch
# =============================================================================
# Never ignore: source code, docs, tests, application assets, config templates.
# =============================================================================


# --- Python Bytecode & Compiled Artifacts -----------------------------------
# Generated by the interpreter on every import. Fully reproducible from source.
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd


# --- Testing & Coverage Artifacts -------------------------------------------
# Caches and reports generated by test runners and coverage tools.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/


# --- Virtual Environments ----------------------------------------------------
# Installed dependencies, not part of the project source.
.venv/
venv/
env/
ENV/


# --- Environment Variables & Local Configuration -----------------------------
# Machine-specific secrets and overrides. Template is in pyproject.toml.
.env
.env.*

# Application bootstrap and integrity state. This directory can contain the
# permit-signing key and signed checkpoint-integrity metadata.
/config/


# --- Runtime Databases -------------------------------------------------------
# Auto-generated SQLite databases containing user/runtime data.
# data/memory.db is created on first run; not required for boot.
# WAL mode produces -wal/-shm sidecars alongside the database file.
*.db
*.db-wal
*.db-shm
*.sqlite3
*.sqlite


# --- Logs --------------------------------------------------------------------
# All generated log files regardless of location or naming pattern.
*.log
renderer_error.log


# --- Runtime Data Directory --------------------------------------------------
# Only ignore runtime-generated artifacts inside data/.
# Preserves data/.gitkeep and legitimate project resources.
data/*.db
data/*.sqlite
data/*.sqlite3
data/*.log
data/temp_*
data/debug_*
data/*cache*
data/opencode_debug.log
data/diag_runtime.py
data/temp_debug_test*.py
data/checkpoints/
data/session_memory/
data/workspace/


# --- Temporary & Debug Artifacts ---------------------------------------------
# Scratch files, debug scripts, temporary test modules, diagnostics.
# Identified by purpose, not name: these are non-reproducible exploratory files.
scratch_*.py
temp_debug*.py
test_groq.py
/check_schema.py
/test_lock.py
/test_lock_packaged.py
/test_mutex_hold.py

# Phase-validation outputs. The maintained checks live under tests/.
/.p12-closure-*/
/.p12-packaged-*/
/artifacts/
/test_plugin_root/


# --- IDE & Developer Tool Metadata ------------------------------------------
# Machine-specific editor/IDE configuration and tool caches.
.vscode/
.idea/
.qodo/
.agents/
*.code-workspace


# --- Operating System Metadata -----------------------------------------------
# Files created by the OS filesystem, not the project.
.DS_Store
Thumbs.db
desktop.ini


# --- Build Artifacts ---------------------------------------------------------
# Output of packaging tools (hatchling, pip wheel, setuptools).
build/
dist/
installer_output/
*.egg-info/


# --- Scratch / Working Directories -------------------------------------------
# Empty or user-created scratch directories. Not project source.
dummy/
workspace/
scratch/
/logs/
/samaktha_plugins/

# --- Local-only Docs -----------------------------------------------------------
# Generated for local / AI-tool consumption. Intentionally NOT published to the
# public repository.
docs/PROJECT_AUDIT.md
docs/TECHNICAL_AUDIT.md
docs/Samaktha_Implementation_Maturity_Checklist.md
